{
  "name": "Yehuda Add-ons",
  "url": "https://github.com/yehudafh/ha_addon",
  "maintainer": "Yehuda Fahima",
  "email": "yehudafh@gmail.com",
  "addons": [
    {
      "name": "OpenWRT Add-on",
      "slug": "openwrt",
      "version": "1.0.1",
      "url": "https://github.com/yehudafh/ha_addon/openwrt",
      "arch": ["amd64", "armv7", "aarch64"],
      "startup": "system",
      "boot": "auto",
      "host_network": true,
      "privileged": ["NET_ADMIN", "SYS_ADMIN"],
      "map": ["config:rw"],
      "options": {},
      "schema": {}
    },
    {
      "name": "Pool Monitor",
      "slug": "pool_monitor",
      "description": "An add-on to monitor and maintain your pool's chemical levels.",
      "url": "https://github.com/yehudafh/ha_addon/pool_monitor",
      "arch": ["amd64", "armv7", "armhf"],
      "startup": "application",
      "boot": "auto",
      "options": {
        "pool_volume_liters": 10000,
        "pool_type": "chlorine"
      },
      "schema": {
        "pool_volume_liters": "int",
        "pool_type": "str"
      },
      "version": "1.0.1"
    }
  ]
}
